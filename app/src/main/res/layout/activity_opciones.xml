<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#607089"
    tools:context=".Opciones">

    <!-- TopBar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#3CA4E0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="Menú"
            android:src="@drawable/menu" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Club Deportivo"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/circle_background"
            android:clipToOutline="true"
            android:contentDescription="Perfil"
            android:scaleType="centerCrop"
            android:src="@drawable/image19" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollOpciones"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Lista Clientes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardListaSocios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:text="Lista Clientes"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <TextView
                        android:layout_marginTop="6dp"
                        android:text="Ingresa aquí para listar los clientes."
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContadorSocios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Socios: XX"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnContadorNoSocios"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Socios: YY"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Registro Clientes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:text="Registro de Clientes"
                        android:textColor="#000000"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <TextView
                        android:layout_marginTop="6dp"
                        android:text="Ingresa aquí para anotar a nuevos clientes"
                        android:textColor="#333333"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegistrarCliente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registrar"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTotalClientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Clientes: ZZ"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Vencimientos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVencimientos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:text="Vencimientos"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Revisa qué socios no tienen la cuota al día."
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVencimientosHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hoy"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnVencimientosSemana"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Esta semana"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pagos -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPagos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:backgroundTint="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:text="Pagos"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#000000"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <TextView
                        android:text="Registra los pagos correspondientes"
                        android:textSize="14sp"
                        android:textColor="#333333"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegistrarPago"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registrar"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnHistorialPagos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Historial"
                            android:textSize="14sp"
                            android:textColor="@android:color/white"
                            android:layout_margin="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            app:cornerRadius="12dp"
                            android:backgroundTint="#020202"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>