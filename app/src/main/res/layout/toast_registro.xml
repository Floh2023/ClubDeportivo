<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_toast_container"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <ImageView
        android:layout_width="75dp"
        android:layout_height="78dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_icon_circle"
        android:src="@drawable/icon" />

    <TextView
        android:id="@+id/toast_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="El socio fue creado"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAceptar"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_aceptar"
            android:text="Deshacer"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"
            style="@android:style/Widget.Button"
            android:textColor="#000000" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCarnet"
            android:layout_width="90dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_cancelar"
            android:text="Cerrar"
            android:textSize="12sp"
            style="@android:style/Widget.Button"
            android:textColor="#ffffff" />
    </LinearLayout>
</LinearLayout>